# Copy to .env and adjust. .env is git-ignored — never commit it.
# The admin signs in as "admin" with this password (12+ characters). Used to create the account on first start.
# TDC_ADMIN_PASSWORD=

# Optional: one Telegram app (my.telegram.org) for everyone, so people sign in with just their phone number.
# TDC_TELEGRAM_API_ID=
# TDC_TELEGRAM_API_HASH=

# New accounts (Create account on the sign-in page). Set to 0 to close registration.
# TDC_ALLOW_REGISTRATION=1
# Invitation only: new accounts must enter this code.
# TDC_INVITE_CODE=
# Limits on new accounts: per address per day, and in total.
# TDC_SIGNUPS_PER_IP_PER_DAY=3
# TDC_MAX_USERS=200
# A browser stays signed in until sign-out, or after this many days without use.
# TDC_SESSION_DAYS=30

# Seals stored secrets (Telegram sessions, API hashes). Strongly recommended on cloud hosts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TDC_MASTER_KEY=

# Where the console listens. Keep 127.0.0.1 unless HTTPS (TLS or a tunnel) is in front.
TDC_HOST=127.0.0.1
TDC_PORT=8640

# The Telegram Drive desktop app's REST API (Settings → Advanced). The key can also be set in the UI.
TDC_DRIVE_API_URL=http://127.0.0.1:8550/api/v1
# TDC_DRIVE_API_KEY=

# Behind Railway / Render / Fly.io / Cloudflare Tunnel / Tailscale Serve (number of proxy hops):
# TDC_TRUST_PROXY=1
# TDC_COOKIE_SECURE=1

# Direct HTTPS instead of a proxy:
# TDC_TLS_CERT=/path/fullchain.pem
# TDC_TLS_KEY=/path/privkey.pem

# Uploads go up in resumable chunks (MB). Keep below any proxy/tunnel request cap (Cloudflare Free: 100 MB).
# TDC_UPLOAD_CHUNK_MB=16
# Maximum upload size in MB (Telegram's limit is ~1907 MB = 2,000,000,000 bytes).
# TDC_MAX_UPLOAD_MB=1907
