{
  "name": "kurovault",
  "private": true,
  "version": "1.0.0",
  "description": "Kurovault — a self-hosted, security-hardened web vault for your Telegram Drive files: monitored access, audit trail, and in-browser video, audio, PDF and image playback.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/admin.js",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run build && playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "test:unit": "node tests/archive.unit.mjs"
  },
  "dependencies": {
    "@ip-location-db/dbip-city-mmdb": "^2.3.2026060513",
    "big-integer": "^1.6.52",
    "fastify": "^5.12.7",
    "maxmind": "^5.0.8",
    "node-unrar-js": "^2.0.2",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
